# Highrise Bot Configuration for Local Hosting
# Copy this file to .env and fill in the values

# Required: Your Highrise room ID
ROOM_ID=your_room_id_here

# Required: Your Highrise API token
API_TOKEN=your_api_token_here

# Optional: Public URL for music server (if behind reverse proxy)
# Leave empty to use localhost:5000
PUBLIC_URL=

# Optional: Override port for music server
PORT=5000
